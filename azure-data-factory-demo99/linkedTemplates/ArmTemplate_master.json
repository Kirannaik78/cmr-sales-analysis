{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azure-data-factory-demo99"
		},
		"AzureDatabricksDeltaLake1_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricksDeltaLake1'"
		},
		"Databricks_linked_service_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'Databricks_linked_service'"
		},
		"RawDataSourceLinkedService_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'RawDataSourceLinkedService'"
		},
		"StagingService_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'StagingService'"
		},
		"azure_table_storage_sink_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'azure_table_storage_sink'"
		},
		"RawDataSourceLinkedService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://rawdatatest.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azure-data-factory-demo99_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDatabricksDeltaLake1_accessToken": {
						"value": "[parameters('AzureDatabricksDeltaLake1_accessToken')]"
					},
					"Databricks_linked_service_accessToken": {
						"value": "[parameters('Databricks_linked_service_accessToken')]"
					},
					"RawDataSourceLinkedService_accountKey": {
						"value": "[parameters('RawDataSourceLinkedService_accountKey')]"
					},
					"StagingService_connectionString": {
						"value": "[parameters('StagingService_connectionString')]"
					},
					"azure_table_storage_sink_connectionString": {
						"value": "[parameters('azure_table_storage_sink_connectionString')]"
					},
					"RawDataSourceLinkedService_properties_typeProperties_url": {
						"value": "[parameters('RawDataSourceLinkedService_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}